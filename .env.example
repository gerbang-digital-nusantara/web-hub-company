# Port server (default 3076 — sama dengan web-hub-v2, yang akan digantikan situs ini).
PORT=3076
# Folder front-end statis.
WEB_ROOT=./view
# Tempat menyimpan permintaan demo (demo-requests.jsonl).
DATA_DIR=./data
# Di belakang Nginx isi X-Forwarded-For supaya IP asli tercatat & limiter adil.
PROXY_HEADER=

# hub-control Partner API (registrasi tenant coba gratis dari form Minta Demo).
# Kosong = form demo hanya dicatat ke demo-requests.jsonl seperti dulu.
# Key & Secret dari admin hub-control (menu Partner API). SECRET hanya di .env
# server — jangan pernah ditaruh di view/ (terbaca browser).
HUBCTL_BASE_URL=https://hub-control.xpanca.com
HUBCTL_API_KEY=
HUBCTL_API_SECRET=
